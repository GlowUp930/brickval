{
  "expo": {
    "name": "Brickvalue",
    "slug": "brickvalue",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "brickval",
    "splash": {
      "backgroundColor": "#0d0d0f"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "12",
      "bundleIdentifier": "com.brickval.app",
      "infoPlist": {
        "NSCameraUsageDescription": "BrickVal uses your camera to scan minifigures and parts.",
        "NSPhotoLibraryUsageDescription": "BrickVal lets you choose a photo to identify minifigures and parts."
      }
    },
    "android": {
      "package": "com.brickval.app",
      "versionCode": 12,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-camera",
        {
          "cameraPermission": "BrickVal uses your camera to scan minifigures and parts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BrickVal lets you choose a photo to identify minifigures and parts."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "enableNativePaywall": true,
      "internalTestingUnlimitedScans": true,
      "router": {},
      "eas": {
        "projectId": "fa3ae6da-2a21-46f9-84c5-50c0cbe689d6"
      }
    }
  }
}
