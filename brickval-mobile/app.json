{
  "expo": {
    "name": "Brickvalue",
    "slug": "brickvalue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "brickval",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0d0d0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brickval.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Brickvalue uses your camera to scan LEGO sets and look up market prices."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d0f"
      },
      "package": "com.brickval.app",
      "permissions": ["CAMERA", "VIBRATE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Brickvalue uses your camera to scan LEGO sets and look up market prices."
        }
      ],
      "react-native-reanimated/plugin"
    ]
  }
}
