{
  "expo": {
    "name": "Brickvalue",
    "slug": "brickvalue",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "brickval",
    "splash": {
      "backgroundColor": "#0d0d0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brickval.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Brickvalue uses your camera to scan LEGO sets and look up market prices."
      }
    },
    "android": {
      "package": "com.brickval.app",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Brickvalue uses your camera to scan LEGO sets and look up market prices."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "enableNativePaywall": true,
      "router": {},
      "eas": {
        "projectId": "fa3ae6da-2a21-46f9-84c5-50c0cbe689d6"
      }
    }
  }
}
