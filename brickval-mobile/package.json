{
  "name": "brickval-mobile",
  "version": "1.0.0",
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "test": "tsx --test tests/*.test.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "submit:ios": "npx eas-cli submit --platform ios --profile production"
  },
  "dependencies": {
    "@clerk/expo": "^3.1.11",
    "@expo/ui": "~57.0.3",
    "@sentry/react-native": "~7.11.0",
    "@types/react": "~19.2.10",
    "expo": "^57.0.2",
    "expo-apple-authentication": "~57.0.0",
    "expo-auth-session": "~57.0.1",
    "expo-blur": "~57.0.0",
    "expo-camera": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-sensors": "~57.0.1",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-store-review": "~57.0.0",
    "expo-superwall": "^1.1.4",
    "expo-symbols": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-video": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "lucide-react-native": "^1.22.0",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-purchases": "^9.0.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.1.0",
    "@types/react": "~19.2.10",
    "patch-package": "^8.0.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
