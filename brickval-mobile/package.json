{
  "name": "brickval-mobile",
  "version": "1.0.0",
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "test": "tsx --test tests/*.test.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "submit:ios": "npx eas-cli submit --platform ios --profile production"
  },
  "dependencies": {
    "@clerk/expo": "^3.1.11",
    "@sentry/react-native": "~7.11.0",
    "@types/react": "~19.2.10",
    "expo": "~55.0.27",
    "expo-apple-authentication": "~55.0.14",
    "expo-auth-session": "~55.0.17",
    "expo-blur": "~55.0.15",
    "expo-camera": "~55.0.20",
    "expo-constants": "~55.0.15",
    "expo-crypto": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-haptics": "~55.0.15",
    "expo-image-picker": "~55.0.21",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.15",
    "expo-sensors": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.15",
    "expo-superwall": "^1.1.4",
    "expo-video": "~55.0.18",
    "expo-web-browser": "~55.0.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.6",
    "react-native-purchases": "^9.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "patch-package": "^8.0.1",
    "tsx": "^4.22.4",
    "typescript": "~5.9.0"
  }
}
