    "BrickValue uses data from reliable sources.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue يستخدم بيانات من مصادر موثوقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue verwendet Daten aus zuverlässigen Quellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue uses data from reliable sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue utiliza datos de fuentes confiables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue utilise des données provenant de sources fiables."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue विश्वसनीय स्रोतों से डेटा का उपयोग करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue utilizza dati provenienti da fonti affidabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue は信頼できるソースからのデータを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue는 신뢰할 수 있는 출처의 데이터를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue gebruikt gegevens uit betrouwbare bronnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O BrickValue usa dados de fontes confiáveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue使用来自可靠来源的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue使用來自可靠來源的資料。"
          }
        }
      }
    },
    "BrickValue will only send reminders you choose. We do not send inactivity or generic marketing notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سترسل BrickValue فقط التذكيرات التي تختارها. نحن لا نرسل إشعارات تسويقية غير نشطة أو عامة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue sendet nur Erinnerungen, die Sie auswählen. Wir senden keine Inaktivitäts- oder generischen Marketingbenachrichtigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue will only send reminders you choose. We do not send inactivity or generic marketing notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue solo te enviará los recordatorios que elijas. No enviamos notificaciones de marketing genéricas o de inactividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue n'enverra que les rappels que vous choisissez. Nous n'envoyons pas de notifications d'inactivité ou de marketing générique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue केवल आपके द्वारा चुने गए रिमाइंडर भेजेगा। हम निष्क्रियता या सामान्य मार्केटिंग नोटिफ़िकेशन नहीं भेजते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue invierà solo i promemoria che scegli. Non inviamo notifiche di inattività o di marketing generico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue は、選択したリマインダーのみを送信します。非アクティブな通知や一般的なマーケティング通知は送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue은 선택한 알림만 전송합니다. 당사는 비활성 또는 일반 마케팅 알림을 보내지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue stuurt alleen herinneringen die jij kiest. We sturen geen inactiviteits- of generieke marketingmeldingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O BrickValue só enviará lembretes que você escolher. Não enviamos notificações de inatividade ou marketing genérico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue只会发送您选择的提醒。我们不会发送不活动或通用的营销通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue只會傳送您選擇的提醒。我們不會發送不活躍或一般的行銷通知。"
          }
        }
      }
    },
    "Bring three friends to BrickVal. When they join and finish onboarding, you unlock three bonus bulk scans.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحضر ثلاثة أصدقاء إلى BrickVal. عندما ينضمون وينهون عملية التأهيل لبدء العمل، يمكنك فتح ثلاث عمليات مسح مجمعة إضافية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring drei Freunde zu BrickVal. Wenn sie beitreten und das Onboarding abschließen, schaltest du drei Bonus-Massen-Scans frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring three friends to BrickVal. When they join and finish onboarding, you unlock three bonus bulk scans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae a tres amigos a BrickVal. Cuando se unen y finalizan la incorporación, desbloqueas tres escaneos masivos de bonificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amenez trois amis à BrickVal. Lorsqu'ils rejoignent et terminent l'intégration, vous débloquez trois scans groupés bonus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन दोस्तों को BrickVal पर लाएँ। जब वे शामिल होते हैं और ऑनबोर्डिंग पूरी करते हैं, तो आप तीन बोनस बल्क स्कैन अनलॉक करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta tre amici a BrickVal. Quando si uniscono e finiscono l'onboarding, sblocchi tre scansioni in blocco bonus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達を 3 人連れて BrickVal に行きます。彼らが参加してオンボーディングを完了すると、3 つのボーナス一括スキャンのロックが解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickVal으로 친구 3명을 데려오세요. 파트너가 가입하고 온보딩을 완료하면 세 가지 보너스 대량 스캔을 잠금 해제할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem drie vrienden mee naar BrickVal. Wanneer ze lid worden en de onboarding voltooien, ontgrendel je drie bonus bulkscans."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga três amigos para o BrickVal. Quando eles se juntarem e terminarem a integração, você desbloqueia três varreduras em massa de bônus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带上三位好友前往BrickVal。当他们加入并完成入驻时，您将解锁三次额外的批量扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶上三位好友前往BrickVal。當他們加入並完成申請流程時，您將解鎖三個額外的批量掃描。"
          }
        }
      }
    },
