    "Your Pro access stays active. Share what happened in a few taps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظل وصولك للمحترفين نشطًا. شارك ما حدث ببضع نقرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Pro-Zugang bleibt aktiv. Erzählen Sie mit wenigen Fingertipps, was passiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Pro access stays active. Share what happened in a few taps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso Pro se mantiene activo. Comparte lo que sucedió en unos pocos toques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre accès Pro reste actif. Partagez ce qui s'est passé en quelques clics."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Pro का ऐक्सेस ऐक्टिव रहता है। कुछ ही टैप में बताएँ कि क्या हुआ था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo accesso Pro rimane attivo. Condividi quello che è successo in pochi tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro アクセスは引き続き有効です。数回タップするだけで何が起こったかを共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 액세스가 활성화된 상태로 유지됩니다. 터치 몇 번으로 상황을 공유하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Pro-toegang blijft actief. Deel wat er is gebeurd in een paar tikken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu acesso Pro permanece ativo. Compartilhe o que aconteceu com apenas alguns toques."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Pro 访问权限保持活动状态。只需点击几下即可分享发生的事情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
