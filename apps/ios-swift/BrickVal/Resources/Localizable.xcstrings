            "value": "Upgrade, um zwischen hellen und dunklen Motiven zu wechseln und deine Akzentfarbe zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade to change between light and dark themes and choose your accent colour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza para cambiar entre temas claros y oscuros y elegir tu color de acento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez à  Pro pour basculer entre les thèmes clairs et sombres et choisissez votre couleur d'accentuation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइट और डार्क थीम के बीच बदलाव करने के लिए अपग्रेड करें और अपना एक्सेंट कलर चुनें।"
          }
        },
        "it": {
          "stringUnit": {
