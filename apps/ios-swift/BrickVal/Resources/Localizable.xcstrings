    "This figure will stay out of the total until it can be identified.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبقى هذا الرقم خارج المجموع حتى يمكن تحديده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zahl bleibt außerhalb der Gesamtsumme, bis sie identifiziert werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This figure will stay out of the total until it can be identified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cifra permanecerá fuera del total hasta que se pueda identificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce chiffre restera en dehors du total jusqu'à ce qu'il puisse être identifié."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आंकड़ा तब तक कुल से बाहर रहेगा जब तक कि इसकी पहचान नहीं हो जाती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cifra rimarrà fuori dal totale fino a quando non potrà essere identificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この数字は、特定されるまで合計に含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 수치는 식별될 때까지 총액에서 제외됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit cijfer blijft buiten het totaal totdat het kan worden geïdentificeerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este valor ficará fora do total até que possa ser identificado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个数字将不会出现在总数中，直到它被识别出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在確定之前，該數字將不屬於總數。"
          }
        }
      }
    },
    "This image couldn't be processed. Choose a smaller JPEG photo and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر معالجة هذه الصورة. اختر صورة JPEG أصغر وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild konnte nicht verarbeitet werden. Wählen Sie ein kleineres JPEG-Foto und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image couldn't be processed. Choose a smaller JPEG photo and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido procesar esta imagen. Elige una foto JPEG más pequeña e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de traiter cette image. Choisissez une photo JPEG plus petite et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो को प्रोसेस नहीं किया जा सका। एक छोटी JPEG फ़ोटो चुनें और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile elaborare l'immagine. Scegli una foto JPEG più piccola e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像は処理できませんでした。小さなJPEG写真を選択して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지를 처리할 수 없습니다. 작은 JPEG 사진을 선택하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
