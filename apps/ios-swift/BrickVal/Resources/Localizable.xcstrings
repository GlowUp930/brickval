    "Place front-facing figures apart from each other, then tap the shutter. Boxes help confirm they are visible.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع الأشكال الأمامية بعيدًا عن بعضها البعض، ثم اضغط على الغالق. تساعد الصناديق في التأكد من أنها مرئية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzieren Sie die nach vorne gerichteten Figuren auseinander und tippen Sie dann auf den Auslöser. Kästchen helfen zu bestätigen, dass sie sichtbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place front-facing figures apart from each other, then tap the shutter. Boxes help confirm they are visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca las figuras frontales separadas entre sí y luego toca el obturador. Las casillas ayudan a confirmar que son visibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez les figurines orientées vers l'avant à l'écart les unes des autres, puis appuyez sur le volet. Les cases aident à confirmer qu'elles sont visibles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामने वाली तस्वीरों को एक - दूसरे से अलग रखें, फिर शटर पर टैप करें। बॉक्स इस बात की पुष्टि करने में मदद करते हैं कि वे दिखाई दे रहे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona le figure frontali una accanto all'altra, quindi tocca l'otturatore. Le caselle aiutano a confermare che sono visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正面を向いた人物を互いに離して配置し、シャッターを押します。ボックスは、ボックスが表示されていることを確認するのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞면 피규어를 서로 간격을 두고 셔터를 누릅니다. 상자가 잘 보이는지 확인하는 데 도움이 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats de naar voren gerichte figuren uit elkaar en tik vervolgens op de sluiter. Vakken helpen bevestigen dat ze zichtbaar zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque as figuras viradas para a frente afastadas umas das outras e, em seguida, toque no obturador. As caixas ajudam a confirmar que estão visíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将正面人偶彼此分开，然后轻按快门。方框有助于确认其可见性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將正面公仔分開放置，然後輕觸快門。方塊有助確認它們是否可見。"
          }
        }
      }
    },
