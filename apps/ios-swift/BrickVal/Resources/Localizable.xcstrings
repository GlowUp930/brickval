    "Automatic scan paused. Tap the shutter to scan manually.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف المسح التلقائي مؤقتًا. اضغط على الغالق للمسح الضوئي يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Scannen angehalten. Tippen Sie auf den Auslöser, um manuell zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic scan paused. Tap the shutter to scan manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis automático en pausa. Toque el obturador para escanear manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numérisation automatique en pause. Appuyez sur l'obturateur pour numériser manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटोमैटिक स्कैन रोक दिया गया। मैन्युअल रूप से स्कैन करने के लिए शटर पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansione automatica in pausa. Toccare l'otturatore per eseguire la scansione manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動スキャンが一時停止しました。シャッターをタップして手動でスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 스캔이 일시 중지되었습니다. 셔터를 눌러 수동으로 스캔합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische scan gepauzeerd. Tik op de sluiter om handmatig te scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalização automática pausada. Toque no obturador para digitalizar manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动扫描已暂停。轻触快门以手动扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動掃描已暫停。點選快門以手動掃描。"
          }
        }
      }
    },
    "Automatic scanning paused because the on-device detector could not start.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف المسح التلقائي مؤقتًا بسبب تعذر بدء تشغيل الكاشف الموجود على الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der automatische Scanvorgang wurde angehalten, da der geräteinterne Detektor nicht gestartet werden konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic scanning paused because the on-device detector could not start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis automático se detuvo porque el detector en el dispositivo no pudo iniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse automatique a été interrompue car le détecteur sur l'appareil n'a pas pu démarrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटोमैटिक स्कैनिंग रोक दी गई क्योंकि ऑन - डिवाइस डिटेक्टर शुरू नहीं हो सका।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione automatica è stata sospesa perché non è stato possibile avviare il rilevatore sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイス検出器が起動できなかったため、自動スキャンが一時停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온디바이스 감지기를 시작할 수 없어 자동 스캔이 일시 중지되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch scannen gepauzeerd omdat de detector op het apparaat niet kon starten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A varredura automática foi pausada porque o detector no dispositivo não pôde ser iniciado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动扫描暂停，因为设备上检测器无法启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於裝置上的偵測器無法啟動，自動掃描已暫停。"
          }
        }
      }
    },
