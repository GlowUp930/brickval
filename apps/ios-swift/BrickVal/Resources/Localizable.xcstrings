            "state": "translated",
            "value": "No minifigure match was found. Try a closer, brighter photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ninguna coincidencia de minifigura. Prueba con una foto más cercana y brillante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune correspondance de figurine n'a été trouvée. Essayez une photo plus proche et plus lumineuse."
