    "Try again in a moment, or use manual lookup with a BrickLink colour ID.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول مرة أخرى في لحظة، أو استخدم البحث اليدوي باستخدام معرف ألوان BrickLink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es gleich noch einmal oder verwenden Sie die manuelle Suche mit einer BrickLink-Farb-ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again in a moment, or use manual lookup with a BrickLink colour ID."
          }
        },
        "es": {
          "stringUnit": {
