            "value": "Wählen Sie die Sprache für BrickValue. Die Systemstandard-Sprache folgt der Sprache Ihres Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the language used throughout BrickValue. System default follows your device language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el idioma que se usa en todo BrickValue. La opción predeterminada del sistema sigue el idioma de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la langue utilisée dans BrickValue. La langue par défaut du système suit celle de votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue में इस्तेमाल होने वाली भाषा चुनें। सिस्टम डिफ़ॉल्ट आपके डिवाइस की भाषा का पालन करता है।"
