    "Your collection has more room, and every scanner is ready when you are.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي مجموعتك على مساحة أكبر، وكل ماسحة ضوئية جاهزة عندما تكون جاهزًا."
          }
        },
