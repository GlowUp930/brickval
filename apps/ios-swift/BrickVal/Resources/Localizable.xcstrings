    "Save an unlimited collection and support continued pricing and scanner improvements.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ مجموعة غير محدودة وادعم التسعير المستمر وتحسينات الماسح الضوئي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare eine unbegrenzte Sammlung und unterstütze weitere Preis- und Scannerverbesserungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save an unlimited collection and support continued pricing and scanner improvements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorra una colección ilimitada y ayuda a seguir mejorando los precios y los escáneres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économisez une collection illimitée et prenez en charge la tarification continue et les améliorations du scanner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असीमित संग्रह सहेजें और निरंतर मूल्य निर्धारण और स्कैनर सुधारों का समर्थन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmia una collezione illimitata e supporta i continui miglioramenti dei prezzi e dello scanner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限のコレクションを保存し、継続的な価格設定とスキャナーの改善をサポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무제한 컬렉션을 저장하고 지속적인 가격 책정과 스캐너 개선을 지원합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bespaar een onbeperkte verzameling en ondersteun voortdurende prijs- en scannerverbeteringen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve uma coleção ilimitada e ofereça suporte a preços contínuos e melhorias no scanner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存无限集合，并支持持续定价和扫描仪改进。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存無限收藏，並支援持續的定價和掃描器改進。"
          }
        }
      }
    },
    "Save new or used items and track your portfolio value over time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ العناصر الجديدة أو المستخدمة وتتبع قيمة محفظتك بمرور الوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie neue oder gebrauchte Artikel und verfolgen Sie Ihren Portfoliowert im Laufe der Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save new or used items and track your portfolio value over time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda artículos nuevos o usados y haz un seguimiento del valor de tu portafolio a lo largo del tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez des articles neufs ou usagés et suivez la valeur de votre portefeuille au fil du temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई या प्रयुक्त वस्तुओं को सहेजें और समय के साथ अपने पोर्टफोलियो मूल्य को ट्रैक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva articoli nuovi o usati e monitora il valore del tuo portafoglio nel tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規または中古のアイテムを保存し、ポートフォリオの価値を時間の経過とともに追跡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신규 또는 중고 아이템을 저장하고 시간 경과에 따른 포트폴리오 가치를 추적하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar nieuwe of gebruikte items en houd de waarde van je portfolio in de loop van de tijd bij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve itens novos ou usados e acompanhe o valor do seu portfólio ao longo do tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存新的或二手物品，并跟踪一段时间内的投资组合价值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存新的或用過的項目，並追蹤一段時間內的投資組合價值。"
          }
        }
      }
    },
