    "Redeem an eligible Apple offer code to unlock BrickValue Pro.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدل رمز عرض Apple المؤهل لفتح BrickValue Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse einen berechtigten Apple-Angebotscode ein, um BrickValue Pro freizuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redeem an eligible Apple offer code to unlock BrickValue Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canjea un código de oferta de Apple que cumpla los requisitos para desbloquear BrickValue Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un code promotionnel Apple admissible pour débloquer BrickValue Pro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue Pro को अनलॉक करने के लिए एक योग्य Apple ऑफ़र कोड रिडीम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscatta un codice di offerta Apple idoneo per sbloccare BrickValue Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象となるAppleオファーコードを利用して、BrickValue PROのロックを解除しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요건을 충족하는 Apple 혜택 코드를 사용하여 BrickValue PRO를 잠금 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel een in aanmerking komende Apple aanbiedingscode in om BrickValue Pro te ontgrendelen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resgate um código de oferta elegível da Apple para desbloquear o BrickValue Pro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兑换符合条件的Apple优惠码，解锁BrickValue PRO。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兌換符合資格的Apple優惠碼，即可解鎖BrickValue PRO。"
          }
        }
      }
    },
