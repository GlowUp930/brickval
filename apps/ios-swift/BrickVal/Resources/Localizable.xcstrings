    },
    "This scan session has expired. Retake the photo to try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية جلسة الفحص هذه. أعد التقاط الصورة للمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Scan-Sitzung ist abgelaufen. Nimm das Foto erneut auf, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This scan session has expired. Retake the photo to try again."
          }
        },
        "es": {
