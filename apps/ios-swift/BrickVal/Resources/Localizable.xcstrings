    "Turn notifications on in Settings to use a reminder you requested.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتشغيل الإشعارات في الإعدادات لاستخدام تذكير طلبته."
          }
        },
        "de": {
          "stringUnit": {
