    "Two focused ways to find value, depending on what is in front of you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريقتان مركزتان للعثور على القيمة، اعتمادًا على ما هو أمامك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei fokussierte Möglichkeiten, um Wert zu finden, je nachdem, was vor Ihnen liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two focused ways to find value, depending on what is in front of you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos formas específicas de encontrar valor, dependiendo de lo que tengas delante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux façons ciblées de trouver de la valeur, en fonction de ce qui est devant vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सामने मौजूद चीज़ों के आधार पर मूल्य खोजने के दो फ़ोकस तरीके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due modi mirati per trovare valore, a seconda di ciò che hai di fronte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目の前にあるものに応じて、価値を見つけるための2つの焦点を当てた方法。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신 앞에 무엇이 있는지에 따라 가치를 찾는 두 가지 집중적인 방법이 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee gerichte manieren om waarde te vinden, afhankelijk van wat er voor je ligt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas maneiras focadas de encontrar valor, dependendo do que estiver à sua frente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据眼前的情况，有两种集中的方式来寻找价值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種專注的方式來尋找價值，具體取決於你面前的東西。"
          }
        }
      }
    },
