    "Tell me when a subscription needs attention.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرني عندما يحتاج الاشتراك إلى الاهتمام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagen Sie mir, wann ein Abonnement Aufmerksamkeit benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me when a subscription needs attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dime cuándo una suscripción necesita atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-moi quand un abonnement a besoin d'attention."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब किसी सब्सक्रिप्शन पर ध्यान देने की ज़रूरत हो, तो मुझे बताएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimmi quando un abbonamento richiede attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションに注意が必要な場合に教えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독에 주의가 필요할 때 알려주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel me wanneer een abonnement aandacht nodig heeft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga-me quando uma assinatura precisa de atenção."
          }
