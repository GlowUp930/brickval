    "You can continue without an account and sign in later from Profile.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك المتابعة بدون حساب وتسجيل الدخول لاحقًا من الملف الشخصي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst ohne Konto fortfahren und dich später über das Profil anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue without an account and sign in later from Profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes continuar sin una cuenta e iniciar sesión más tarde desde Perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer sans compte et vous connecter plus tard depuis Profil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बिना खाते के जारी रख सकते हैं और बाद में प्रोफ़ाइल से साइन इन कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi continuare senza un account e accedere più tardi dal Profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなしで続行し、後でプロフィールからサインインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이 계속한 다음 나중에 프로필에서 로그인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt doorgaan zonder account en je later aanmelden via Profiel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode continuar sem uma conta e iniciar sessão mais tarde pelo Perfil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在没有账户的情况下继续，稍后从个人资料登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在沒有帳戶的情況下繼續，稍後從個人檔案登入。"
          }
        }
      }
    },
