            "value": "Vérifiez la valeur avant de mettre en vente, d'acheter ou de négocier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिस्ट करने, खरीदने या बातचीत करने से पहले मूल्य की जाँच करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
