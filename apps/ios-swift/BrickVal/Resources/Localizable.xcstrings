          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanmelden is vereist om uitnodigingen te maken en te volgen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário fazer login para criar e acompanhar convites."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建和跟踪邀请需要登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須登入才能建立和追蹤邀請。"
          }
        }
      }
    },
    "Sign-in is unavailable in this build. You can continue and sign in later from Profile.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول غير متاح في هذا الإصدار. يمكنك المتابعة وتسجيل الدخول لاحقًا من الملف التعريفي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist in diesem Build nicht verfügbar. Sie können fortfahren und sich später im Profil anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in is unavailable in this build. You can continue and sign in later from Profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión no está disponible en esta compilación. Puedes continuar e iniciar sesión más tarde desde Perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n'est pas disponible dans cette version. Vous pouvez continuer et vous connecter plus tard à partir du profil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बिल्ड में साइन - इन उपलब्ध नहीं है। आप जारी रख सकते हैं और बाद में प्रोफ़ाइल से साइन इन कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso non è disponibile in questa build. Puoi continuare e accedere in un secondo momento da Profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではサインインは利用できません。続行して、後でプロフィールからサインインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에서는 로그인을 사용할 수 없습니다. 계속 진행하고 나중에 프로필에서 로그인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen is niet beschikbaar in deze build. Je kunt verdergaan en later inloggen vanuit Profiel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
