    "Some match details could not be loaded. You can still choose a match.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل بعض تفاصيل المطابقة. لا يزال بإمكانك اختيار تطابق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Match-Details konnten nicht geladen werden. Du kannst immer noch eine Übereinstimmung auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some match details could not be loaded. You can still choose a match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar algunos detalles de la coincidencia. Aún puedes elegir una coincidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains détails de la correspondance n'ont pas pu être chargés. Vous pouvez toujours choisir une correspondance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ मिलान विवरण लोड नहीं किए जा सके. आप अभी भी एक मैच चुन सकते हैं."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare alcuni dettagli della partita. Puoi comunque scegliere un abbinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の試合の詳細を読み込めませんでした。一致するものを選択することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 경기 세부정보를 로드할 수 없습니다. 여전히 일치 항목을 선택할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige wedstrijddetails konden niet worden geladen. Je kunt nog steeds een match kiezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar alguns detalhes da correspondência. Você ainda pode escolher uma correspondência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载某些匹配详细信息。您仍然可以选择匹配项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法加載某些比賽詳細信息。您仍然可以選擇匹配。"
          }
        }
      }
    },
