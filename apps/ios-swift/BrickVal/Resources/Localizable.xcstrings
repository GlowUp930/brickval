    "Scan quickly in stores, markets, or bulk lots.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالمسح الضوئي بسرعة في المتاجر أو الأسواق أو الكميات الكبيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie schnell in Geschäften, Märkten oder großen Mengen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan quickly in stores, markets, or bulk lots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea rápidamente en tiendas, mercados o lotes a granel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numérisation rapide dans les magasins, les marchés ou les lots en vrac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोर, मार्केट या बल्क लॉट में जल्दी से स्कैन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona rapidamente in negozi, mercati o lotti sfusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店舗、市場、または一括ロットですばやくスキャンできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매장, 시장 또는 벌크 부지에서 빠르게 스캔하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan snel in winkels, markten of bulkpartijen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalizar rapidamente em lojas, mercados ou lotes a granel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在商店、市场或批量批次中快速扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在商店、市場或批次中快速掃描。"
          }
        }
      }
    },
    "Scan sets and minifigures, check value, and track your collection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بمسح المجموعات والأشكال المصغرة ضوئيًا، وتحقق من قيمتها، وتتبع مجموعتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie Sets und Minifiguren, überprüfen Sie den Wert und verfolgen Sie Ihre Sammlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan sets and minifigures, check value, and track your collection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea conjuntos y minifiguras, comprueba el valor y realiza un seguimiento de tu colección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez des ensembles et des figurines, vérifiez la valeur et suivez votre collection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेट और मिनीफ़िगर स्कैन करें, वैल्यू जाँचें और अपने कलेक्शन को ट्रैक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona set e minifigure, controlla il valore e monitora la tua collezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットとミニフィギュアをスキャンし、値を確認してコレクションを追跡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트와 미니 피규어를 스캔하고, 가치를 확인하고, 컬렉션을 추적하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan sets en minifiguren, controleer de waarde en volg je verzameling."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalize conjuntos e minifiguras, verifique o valor e acompanhe sua coleção."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描套装和迷你人偶，检查值，并跟踪您的收藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描套裝和迷你人偶，檢查數值，並追蹤你的收藏。"
          }
        }
      }
    },
    "Scan sets and minifigures, then see recent market values in seconds.": {
      "localizations": {
        "ar": {
