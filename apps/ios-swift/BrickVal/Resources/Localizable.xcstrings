    "Join me on BrickVal and find the value of your LEGO collection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم إلي على BrickVal وابحث عن قيمة مجموعة LEGO الخاصة بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begleite mich auf BrickVal und finde den Wert deiner LEGO-Kollektion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join me on BrickVal and find the value of your LEGO collection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a mí en BrickVal y descubre el valor de tu colección de LEGO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez-moi sur BrickVal et trouvez la valeur de votre collection LEGO."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickVal पर मेरे साथ जुड़ें और अपने LEGO संग्रह का मूल्य जानें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti a me su BrickVal e scopri il valore della tua collezione LEGO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickVal に参加して、LEGO コレクションの価値を見つけてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickVal에 가입하여 LEGO 컬렉션의 가치를 찾아보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga met mij mee op BrickVal en ontdek de waarde van uw LEGO-collectie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte-se a mim no BrickVal e encontre o valor da sua coleção LEGO."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入我的 BrickVal 并发现您的 LEGO 收藏的价值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入我的 BrickVal 並發現您的 LEGO 收藏的價值。"
          }
        }
      }
    },
    "Join me on BrickVal and find the value of your LEGO collection. Use my invite code %@: https://brickvalue.live/r/%@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم إليّ على BrickVal واعثر على قيمة مجموعة LEGO الخاصة بك. استخدم الخاص بي %1$@: https://brickvalue.live/r/%2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuchen Sie mich auf BrickVal und finden Sie den Wert Ihrer LEGO-Kollektion. Meinen Einladungscode %1$@ verwenden:https://brickvalue.live/r/%2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join me on BrickVal and find the value of your LEGO collection. Use my invite code %1$@: https://brickvalue.live/r/%2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a mí en BrickVal y descubre el valor de tu colección LEGO. Usa mi código de invitación %1$@: https://brickvalue.live/r/%2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez-moi sur BrickVal et trouvez la valeur de votre collection LEGO. Utilisez mon code d'invitation %1$@ : https://brickvalue.live/r/%2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickVal पर मेरे साथ जुड़ें और अपने LEGO संग्रह की कीमत जानें। मेरा आमंत्रण कोड इस्तेमाल करें %1$@: https://brickvalue.live/r/%2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti a me su BrickVal e trova il valore della tua collezione LEGO. Usa il mio codice di invito %1$@: https://brickvalue.live/r/%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValで私と一緒にLEGOコレクションの価値を確認しましょう。招待コード %1$@ を使ってください：https://brickvalue.live/r/%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickVal에 가입해 LEGO 컬렉션의 가치를 확인해 보세요. 제 초대 코드 %1$@를 사용하세요: https://brickvalue.live/r/%2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe mee op BrickVal en ontdek de waarde van je LEGO-collectie. Gebruik mijn uitnodigingscode %1$@: https://brickvalue.live/r/%2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte-se a mim no BrickVal e encontre o valor da sua coleção LEGO. Use meu código de convite %1$@: https://brickvalue.live/r/%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 BrickVal，发现你的 LEGO 收藏价值。使用我的邀请码 %1$@：https://brickvalue.live/r/%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 BrickVal，發掘你的 LEGO 收藏價值。使用我的邀請碼 %1$@：https://brickvalue.live/r/%2$@"
          }
        }
      }
    },
