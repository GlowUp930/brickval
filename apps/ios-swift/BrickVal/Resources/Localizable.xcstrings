    "Your feedback helps more LEGO collectors find the app and helps us improve it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعد ملاحظاتك المزيد من جامعي LEGO في العثور على التطبيق وتساعدنا على تحسينه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Feedback hilft mehr LEGO-Sammlern, die App zu finden, und hilft uns, sie zu verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feedback helps more LEGO collectors find the app and helps us improve it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus comentarios ayudan a más coleccionistas de LEGO a encontrar la aplicación y nos ayudan a mejorarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos commentaires aident davantage de collectionneurs LEGO à trouver l'application et nous aident à l'améliorer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फ़ीडबैक से ज़्यादा LEGO कलेक्टरों को ऐप ढूँढने में मदद मिलती है और हमें इसे बेहतर बनाने में मदद मिलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo feedback aiuta più collezionisti di LEGO a trovare l'app e ci aiuta a migliorarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのフィードバックは、より多くの LEGO コレクターがアプリを見つけ、私たちがアプリを改善するのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 피드백은 더 많은 LEGO 수집가가 앱을 찾고 개선하는 데 도움이 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
