        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पल में फिर से कोशिश करें, या BrickLink रंग आईडी के साथ मैन्युअल लुकअप का उपयोग करें।"
          }
        },
        "it": {
