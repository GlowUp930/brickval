          "stringUnit": {
            "state": "translated",
            "value": "価格設定されたミニフィギュアは見つかりませんでした。図形を分離して前を向いた明るい写真をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격이 책정된 미니 피규어가 없습니다. 피규어를 분리하고 정면을 향하게 하여 더 밝은 사진을 찍어보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen geprijsde minifiguren gevonden. Probeer een helderdere foto met de figuren gescheiden en naar voren gericht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma minifigura precificada foi encontrada. Tente uma foto mais brilhante com as figuras separadas e voltadas para a frente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到定价的小人仔。尝试一张更明亮的照片，人物分开并面向前方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到定價的小人仔。嘗試一張更明亮的照片，人物分開並面向前方。"
          }
        }
      }
    },
