    "Invite accepted. You now count toward your friend's reward.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite accepted. You now count toward your friend's reward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitación aceptada. Ahora cuentas para la recompensa de tu amigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation acceptée. Vous comptez maintenant pour la récompense de votre ami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung angenommen. Du zählst jetzt für die Belohnung deines Freundes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invito accettato. Ora contribuisci al premio del tuo amico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convite aceito. Você agora conta para a recompensa do seu amigo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodiging geaccepteerd. Je telt nu mee voor de beloning van je vriend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待を承認しました。友達の特典獲得に向けた人数にカウントされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대를 수락했습니다. 이제 친구의 보상 조건에 반영됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接受邀请。你现在已计入好友的奖励进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已接受邀請。你現在已計入好友的獎勵進度。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قبول الدعوة. أصبحت الآن محسوبًا ضمن تقدم صديقك نحو المكافأة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रण स्वीकार किया गया। अब आपको आपके मित्र के पुरस्कार की प्रगति में गिना जाएगा।"
          }
        }
      }
    },
