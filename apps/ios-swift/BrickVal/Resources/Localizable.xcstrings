    "See the average of recent sold prices, or a clearly labeled average asking price from active listings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على متوسط أسعار البيع الحديثة، أو متوسط السعر المطلوب للعروض النشطة مع توضيح ذلك بجلاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie den Durchschnitt der zuletzt erzielten Verkaufspreise oder den deutlich gekennzeichneten durchschnittlichen Angebotspreis aktiver Angebote."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the average of recent sold prices, or a clearly labeled average asking price from active listings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el promedio de los precios de venta recientes o el precio medio solicitado claramente identificado de los anuncios activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
