    "Brickvalue could not copy your Expo data yet. Nothing was deleted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue لا يمكن نسخ بيانات المعرض الخاصة بك حتى الآن. لم يتم حذف أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue konnte Ihre Expo-Daten noch nicht kopieren. Es wurde nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue could not copy your Expo data yet. Nothing was deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue aún no ha podido copiar sus datos de la Expo. No se eliminó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue n'a pas encore pu copier vos données Expo. Rien n'a été supprimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue अभी तक आपका एक्सपो डेटा कॉपी नहीं कर सका है। कुछ भी डिलीट नहीं किया गया था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue non ha ancora potuto copiare i dati di Expo. Non è stato eliminato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalueはまだ万博データをコピーできませんでした。何も削除されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue는 아직 Expo 데이터를 복사할 수 없습니다. 아무것도 삭제되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue kon je Expo-gegevens nog niet kopiëren. Er is niets verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue ainda não conseguiu copiar seus dados da Expo. Nada foi excluído."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue无法复制您的博览会数据。未删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue無法複製您的世博會資料。未刪除任何內容。"
          }
        }
      }
    },
    "BrickValue gets from camera to market value in seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتقل BrickValue من الكاميرا إلى القيمة السوقية في ثوانٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue kommt in Sekundenschnelle von der Kamera zum Marktwert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue gets from camera to market value in seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue pasa de la cámara al valor de mercado en segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue passe de la caméra à la valeur marchande en quelques secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue सेकंड में कैमरे से मार्केट वैल्यू तक पहुँच जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue passa dalla fotocamera al valore di mercato in pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValueは数秒でカメラから市場価値になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue는 몇 초 만에 카메라에서 시장 가치로 전환됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue bereikt binnen enkele seconden de marktwaarde van de camera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue passa da câmera para o valor de mercado em segundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue在几秒钟内从相机到市场价值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue在幾秒鐘內從相機到市場價值。"
          }
        }
      }
    },
