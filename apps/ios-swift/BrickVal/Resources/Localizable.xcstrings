    "Currency conversion is unavailable. Values are shown in USD.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل العملة غير متاح. تُعرض القيم بالدولار الأمريكي USD."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Währungsumrechnung ist nicht verfügbar. Die Werte werden in USD angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency conversion is unavailable. Values are shown in USD."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversión de moneda no está disponible. Los valores se muestran en USD."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversion de devises est indisponible. Les valeurs sont affichées en USD."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुद्रा रूपांतरण उपलब्ध नहीं है। मान USD में दिखाए जाते हैं。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversione valutaria non è disponibile. I valori sono mostrati in USD."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨換算を利用できません。値はUSDで表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 변환을 사용할 수 없습니다. 값은 USD로 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valutaconversie is niet beschikbaar. De waarden worden in USD weergegeven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversão de moeda está indisponível. Os valores são exibidos em USD."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "货币转换不可用。数值将以 USD 显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貨幣換算無法使用。數值會以 USD 顯示。"
          }
        }
      }
    },
    "Rates are temporarily stale. Values use the last available update.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسعار الصرف قديمة مؤقتًا. تستخدم القيم آخر تحديث متاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wechselkurse sind vorübergehend veraltet. Die Werte verwenden die letzte verfügbare Aktualisierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates are temporarily stale. Values use the last available update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tasas están temporalmente desactualizadas. Los valores usan la última actualización disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux sont temporairement obsolètes. Les valeurs utilisent la dernière mise à jour disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दरें अस्थायी रूप से पुरानी हैं। मानों में आखिरी उपलब्ध अपडेट का उपयोग किया गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tassi sono temporaneamente obsoleti. I valori usano l’ultimo aggiornamento disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "為替レートが一時的に古くなっています。値には最後に利用できた更新が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환율이 일시적으로 오래되었습니다. 값에는 마지막으로 사용 가능한 업데이트가 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wisselkoersen zijn tijdelijk verouderd. De waarden gebruiken de laatst beschikbare update."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As taxas estão temporariamente desatualizadas. Os valores usam a última atualização disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇率暂时过期。数值使用最近一次可用更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯率暫時過期。數值會使用最近一次可用更新。"
          }
        }
      }
    },
    "Currency conversion is unavailable. Values will show in USD until rates load.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل العملة غير متاح. ستُعرض القيم بالدولار الأمريكي USD حتى تحميل الأسعار."
          }
        },
