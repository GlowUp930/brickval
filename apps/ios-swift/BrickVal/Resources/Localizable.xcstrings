    "Your referral reward has been used. Invite more friends to keep growing the community.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استخدام مكافأة الإحالة الخاصة بك. قم بدعوة المزيد من الأصدقاء لمواصلة تنمية المجتمع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Empfehlungsprämie wurde verwendet. Lade weitere Freunde ein, um die Community weiter auszubauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your referral reward has been used. Invite more friends to keep growing the community."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha utilizado tu recompensa por recomendación. Invita a más amigos a seguir haciendo crecer la comunidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre récompense de parrainage a été utilisée. Invitez plus d'amis à continuer de développer la communauté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका रेफ़रल रिवॉर्ड इस्तेमाल कर लिया गया है। समुदाय को बढ़ाते रहने के लिए और दोस्तों को आमंत्रित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua ricompensa per l'invito è stata utilizzata. Invita altri amici per continuare a far crescere la community."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの紹介報酬は使用されました。さらに多くの友達を招待して、コミュニティを成長させ続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 보너스가 사용되었습니다. 커뮤니티를 계속 성장시키려면 더 많은 친구를 초대하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je introductiebeloning is gebruikt. Nodig meer vrienden uit om de community te laten groeien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua recompensa de indicação foi usada. Convide mais amigos para continuar aumentando a comunidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的推荐奖励已被使用。邀请更多的朋友来不断发展社区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的推薦獎勵已被使用。邀請更多的朋友來不斷發展社區。"
          }
        }
      }
    },
