    "Invite accepted. We'll finish counting it when you're back online.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قبول الدعوة. سننتهي من عدها عندما تعود إلى وضع الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung angenommen. Wir werden es fertig zählen, wenn du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite accepted. We'll finish counting it when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitación aceptada. Terminaremos de contarla cuando vuelvas a conectarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation acceptée. Nous finirons de le compter lorsque vous serez de nouveau en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनवाइट मंज़ूर किया गया। आपके ऑनलाइन होने पर हम इसकी गिनती पूरी कर लेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invito accettato. Finiremo di contarli quando tornerai online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待が受け入れられました。オンラインに戻ったらカウントを終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대가 수락되었습니다. 다시 온라인 상태가 되면 계산이 완료됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodiging geaccepteerd. We tellen het af als je weer online bent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convite aceito. Terminaremos de contar quando você estiver online novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接受邀请。当您重新上线时，我们将完成计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已接受邀請。當你重新上線時，我們便會完成計算。"
          }
        }
      }
    },
    "Invite accepted. Your bonus scans are ready.": {
      "localizations": {
        "ar": {
