    "We use the average of recent sold prices. If sold data isn't available, we clearly label the average asking price from active listings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نستخدم متوسط أسعار البيع الحديثة. إذا لم تتوفر بيانات المبيعات، نوضح بجلاء أنه متوسط السعر المطلوب للعروض النشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir verwenden den Durchschnitt der zuletzt erzielten Verkaufspreise. Wenn keine Verkaufsdaten verfügbar sind, kennzeichnen wir den durchschnittlichen Angebotspreis aktiver Angebote deutlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use the average of recent sold prices. If sold data isn't available, we clearly label the average asking price from active listings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos el promedio de los precios de venta recientes. Si no hay datos de ventas, indicamos claramente el precio medio solicitado de los anuncios activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous utilisons la moyenne des prix de vente récents. Si ces données ne sont pas disponibles, nous indiquons clairement le prix moyen demandé des annonces actives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम हाल की बिक्री कीमतों का औसत इस्तेमाल करते हैं। अगर बिक्री का डेटा उपलब्ध न हो, तो हम सक्रिय लिस्टिंग की औसत मांग कीमत को साफ़ तौर पर दिखाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiamo la media dei prezzi di vendita recenti. Se i dati sulle vendite non sono disponibili, indichiamo chiaramente il prezzo medio richiesto degli annunci attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の販売価格の平均を使用します。販売データがない場合は、現在出品中の商品の平均希望価格であることを明示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 판매 가격의 평균을 사용합니다. 판매 데이터가 없으면 현재 등록된 상품의 평균 희망가임을 명확히 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We gebruiken het gemiddelde van recente verkoopprijzen. Als er geen verkoopgegevens beschikbaar zijn, vermelden we duidelijk de gemiddelde vraagprijs van actieve aanbiedingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos a média dos preços de venda recentes. Se não houver dados de vendas, indicamos claramente o preço médio pedido dos anúncios ativos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们使用近期成交价的平均值。如果没有成交数据，我们会明确标注为在售商品的平均要价。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們使用近期成交價的平均值。如果沒有成交資料，我們會明確標示為目前刊登商品的平均叫價。"
          }
        }
      }
    },
