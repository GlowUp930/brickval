    "Choose a different match if this result is not the same figure.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تطابقًا مختلفًا إذا لم تكن هذه النتيجة هي نفس الشكل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine andere Übereinstimmung, wenn dieses Ergebnis nicht die gleiche Zahl ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a different match if this result is not the same figure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una coincidencia diferente si este resultado no es la misma cifra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une correspondance différente si ce résultat n'est pas le même chiffre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि यह परिणाम एक ही आंकड़ा नहीं है, तो एक अलग मिलान चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una corrispondenza diversa se questo risultato non è la stessa cifra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この結果が同じでない場合は、別の一致を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결과가 동일한 수치가 아닌 경우 다른 일치를 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een andere overeenkomst als dit resultaat niet hetzelfde cijfer is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma correspondência diferente se este resultado não for a mesma figura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此结果不是相同的数字，请选择其他匹配项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果結果不是相同的數字，請選擇不同的匹配。"
          }
        }
      }
    },
