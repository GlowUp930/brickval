          "stringUnit": {
            "state": "translated",
            "value": "A câmera ainda está se preparando. Tente novamente em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头仍在准备中。请稍后重试。"
          }
