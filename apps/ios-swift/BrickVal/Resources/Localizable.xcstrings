    "Upgrade to change between light and dark themes and choose your accent colour.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالترقية للتغيير بين السمات الفاتحة والداكنة واختر لون تمييزك."
          }
        },
        "de": {
          "stringUnit": {
