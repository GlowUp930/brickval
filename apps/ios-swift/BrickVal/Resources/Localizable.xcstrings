    "Camera access is off. Enable it in Settings to scan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الكاميرا مغلق. قم بتمكينه في الإعدادات للمسح الضوئي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist deaktiviert. Aktivieren Sie es in den Einstellungen zum Scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off. Enable it in Settings to scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado. Habilítelo en Configuración para escanear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la caméra est désactivé. Activez-le dans Paramètres pour numériser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा पहुंच बंद है. स्कैन करने के लिए इसे सेटिंग्स में सक्षम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è disattivato. Abilitalo in Impostazioni per la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスがオフになっています。スキャンするには設定で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근 권한이 꺼져 있습니다. 스캔하려면 설정에서 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoegang is uitgeschakeld. Schakel het in bij Instellingen om te scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera está desativado. Ative-o nas Configurações para digitalizar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机访问权限已关闭。在“设置”中启用它以进行扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機訪問已關閉。在“設置”中啟用它進行掃描。"
          }
        }
      }
    },
