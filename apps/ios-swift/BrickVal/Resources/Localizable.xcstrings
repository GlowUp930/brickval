    "Unlock automatic and bulk scanning, plus unlimited collection space with Pro.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ميزة المسح التلقائي والجماعي، بالإضافة إلى مساحة تجميع غير محدودة مع Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie automatisches und Bulk-Scannen sowie unbegrenzten Sammelplatz mit Pro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock automatic and bulk scanning, plus unlimited collection space with Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el escaneo automático y masivo, además de un espacio de recolección ilimitado con Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez la numérisation automatique et en bloc, ainsi qu'un espace de collecte illimité avec Pro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रो के साथ ऑटोमैटिक और बल्क स्कैनिंग, साथ ही असीमित संग्रह स्थान अनलॉक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca la scansione automatica e di massa, oltre a uno spazio di raccolta illimitato con Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro では、自動スキャンと一括スキャンのロックを解除し、無制限の収集スペースを利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro를 사용하면 자동 및 대량 스캔과 무제한 수집 공간을 잠금 해제할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel automatisch en bulksgewijs scannen, plus onbeperkte verzamelruimte met Pro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie a digitalização automática e em massa, além de espaço de coleta ilimitado com o Pro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用专业版解锁自动和批量扫描，以及无限的采集空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用Pro解鎖自動掃描和批量掃描，以及無限的收集空間。"
          }
        }
      }
    },
