            "value": "نحن نستخدم هذا فقط لمشاكل الفوترة التي تحتاج إلى اهتمامك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir verwenden diese nur für Abrechnungsprobleme, die Ihre Aufmerksamkeit erfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We only use this for billing problems that need your attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lo usamos para problemas de facturación que requieran tu atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne l'utilisons que pour les problèmes de facturation qui nécessitent votre attention."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम इसका इस्तेमाल सिर्फ़ उन बिलिंग समस्याओं के लिए करते हैं, जिन पर आपको ध्यान देने की ज़रूरत है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo usiamo solo per problemi di fatturazione che richiedono la tua attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは、注意が必要な請求上の問題にのみ使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주의를 기울여야 하는 청구 문제에만 이 정보를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We gebruiken dit alleen voor factureringsproblemen die uw aandacht nodig hebben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos isso apenas para problemas de cobrança que precisam da sua atenção."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
