    },
    "The captured photo is no longer available. Please retake the photo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد الصورة الملتقطة متاحة. يرجى إعادة التقاط الصورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aufgenommene Foto ist nicht mehr verfügbar. Bitte nehmen Sie das Foto erneut auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The captured photo is no longer available. Please retake the photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto capturada ya no está disponible. Vuelve a hacer la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo capturée n'est plus disponible. Veuillez reprendre la photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर की गई फ़ोटो अब उपलब्ध नहीं है। कृपया फ़ोटो फिर से लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto acquisita non è più disponibile. Per favore, scatta di nuovo la foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャされた写真は利用できなくなりました。写真を再撮影してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영된 사진은 더 이상 사용할 수 없습니다. 사진을 다시 촬영해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vastgelegde foto is niet meer beschikbaar. Maak de foto opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto capturada não está mais disponível. Por favor, refaça a foto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄的照片不再可用。请重新拍照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捕獲的照片不再可用。請重新拍攝照片。"
          }
        }
      }
    },
