    "Payment is charged to your Apple ID. Subscriptions renew automatically unless cancelled at least 24 hours before renewal.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع على Apple ID الخاص بك. يتم تجديد الاشتراكات تلقائيًا ما لم يتم إلغاؤها قبل 24 ساعة على الأقل من التجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung erfolgt über deine Apple-ID. Abonnements verlängern sich automatisch, es sei denn, sie werden mindestens 24 Stunden vor der Verlängerung gekündigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple ID. Subscriptions renew automatically unless cancelled at least 24 hours before renewal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga a tu ID de Apple. Las suscripciones se renuevan automáticamente a menos que se cancelen al menos 24 horas antes de la renovación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est facturé sur votre identifiant Apple. Les abonnements sont renouvelés automatiquement, sauf s'ils sont annulés au moins 24 heures avant le renouvellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान आपकी Apple ID से लिया जाता है। नवीनीकरण से कम से कम 24 घंटे पहले रद्द किए जाने तक सदस्यताएँ स्वचालित रूप से नवीनीकृत हो जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento viene addebitato sul tuo ID Apple. Gli abbonamenti si rinnovano automaticamente a meno che non vengano annullati almeno 24 ore prima del rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いはApple IDに請求されます。サブスクリプションは、更新の24時間前までにキャンセルされない限り、自動的に更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 금액은 Apple ID로 청구됩니다. 갱신 최소 24시간 전에 취소하지 않으면 구독이 자동으로 갱신됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaling wordt in rekening gebracht op je Apple ID. Abonnementen worden automatisch verlengd, tenzij ze ten minste 24 uur voor de verlenging worden geannuleerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é cobrado do seu ID Apple. As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes da renovação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款将从您的Apple ID中扣除。除非在续订前至少24小时取消订阅，否则订阅将自动续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款將從您的 Apple ID 中扣除。訂閱會自動續訂，除非在續訂前至少 24 小時取消。"
          }
        }
      }
    },
    "Permanently delete your account?": {
      "localizations": {
        "ar": {
          "stringUnit": {
