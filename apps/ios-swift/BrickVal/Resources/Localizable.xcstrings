    "Choose the language used throughout BrickValue. System default follows your device language.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اللغة المستخدمة في BrickValue. يتبع الإعداد الافتراضي للنظام لغة جهازك."
          }
        },
        "de": {
