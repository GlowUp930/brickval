    "This only changes what Brickvalue highlights for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يغير فقط ما يبرزه Brickvalue لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ändert nur das, was Brickvalue für Sie hervorhebt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only changes what Brickvalue highlights for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo cambia lo que Brickvalue destaca para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne change que ce que Brickvalue met en évidence pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल वही बदलता है जो Brickvalue आपके लिए हाइलाइट करता है।"
          }
        },
