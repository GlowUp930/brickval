            "state": "translated",
            "value": "इनवाइट मंज़ूर कर लिया गया। आपके बोनस स्कैन तैयार हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invito accettato. Le tue scansioni bonus sono pronte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待が受け入れられました。ボーナススキャンの準備が完了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대가 수락되었습니다. 보너스 스캔이 준비되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodiging geaccepteerd. Je bonusscans zijn klaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convite aceito. Suas digitalizações de bônus estão prontas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请已接受。您的奖金扫描已准备就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請已接受。您的額外掃描已準備就緒。"
          }
        }
      }
    },
    "Invite accepted. Your friend is now counted toward your referral progress.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قبول الدعوة. تم احتساب صديقك الآن ضمن تقدمك في الإحالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung angenommen. Dein Freund wird jetzt für deine Weiterempfehlung angerechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite accepted. Your friend is now counted toward your referral progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitación aceptada. Tu amigo ahora cuenta para el progreso de tu invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation acceptée. Votre ami est maintenant pris en compte dans la progression de votre parrainage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनवाइट मंज़ूर कर लिया गया है। अब आपके दोस्त को आपकी रेफ़रल प्रगति में गिना जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invito accettato. Il tuo amico è stato conteggiato per l'avanzamento dell'invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待が受け入れられました。あなたの友人はあなたの紹介の進行状況にカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대가 수락되었습니다. 이제 귀하의 친구가 귀하의 추천 진행 상황에 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodiging geaccepteerd. Je vriend wordt nu meegeteld voor je doorverwijzing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convite aceite. O seu amigo está agora contabilizado para o progresso da sua recomendação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请已接受。您的好友现在已计入您的推荐进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請已接受。您的好友現在會計入您的推薦進度。"
          }
        }
      }
    },
    "Invite accepted. Your friend will count when onboarding is complete.": {
      "localizations": {
