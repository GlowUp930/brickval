    "You’re all set. We’ll only send the reminder you chose.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على أتم الاستعداد. سنرسل التذكير الذي اخترته فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist startklar. Wir senden nur die von dir gewählte Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re all set. We’ll only send the reminder you chose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está todo listo. Solo te enviaremos el recordatorio que hayas elegido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez terminé. Nous n'enverrons que le rappel que vous avez choisi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पूरी तरह से तैयार हैं। हम सिर्फ़ आपकी चुनी हुई रिमाइंडर भेजेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È tutto pronto. Invieremo solo il promemoria che hai scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備は完了です。あなたが選択したリマインダーのみが送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 완료되었습니다. 선택하신 알림만 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent helemaal klaar. We sturen alleen de herinnering die je hebt gekozen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está tudo pronto. Enviaremos apenas o lembrete que você escolheu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经准备好了。我们只会发送您选择的提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經準備好了。我們只會發送您選擇的提醒。"
          }
        }
      }
    },
    "You've reached the bulk scan limit. Upgrade to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد وصلت إلى حد المسح الضوئي المجمع. قم بالترقية للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben das Massen-Scan-Limit erreicht. Upgrade, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached the bulk scan limit. Upgrade to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de escaneo masivo. Actualiza para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint la limite de numérisation en bloc. Passez à un forfait supérieur pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बल्क स्कैन की सीमा तक पहुँच गए हैं। जारी रखने के लिए अपग्रेड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di scansioni in blocco. Effettua l'upgrade per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一括スキャンの制限に達しました。続行するにはアップグレードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벌크 스캔 한도에 도달했습니다. 계속하려면 업그레이드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de limiet voor bulkscans bereikt. Upgrade om door te gaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingiu o limite de digitalização em massa. Atualize para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已达到批量扫描限制。升级以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已達到批量掃描限制。升級才能繼續。"
          }
        }
      }
    },
    "You've reached your scan limit. Upgrade to Brickvalue Pro to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد وصلت إلى حد المسح الضوئي الخاص بك. قم بالترقية إلى Brickvalue PRO للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Scan-Limit erreicht. Upgrade auf Brickvalue Pro, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached your scan limit. Upgrade to Brickvalue Pro to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de escaneo. Actualice a Brickvalue Pro para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint votre limite de numérisation. Passez à Brickvalue Pro pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपनी स्कैन की सीमा तक पहुँच गए हैं। जारी रखने के लिए Brickvalue Pro पर अपग्रेड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di scansioni. Passa a Brickvalue Pro per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン制限に達しました。続行するには、Brickvalue Pro にアップグレードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 한도에 도달했습니다. 계속하려면 Brickvalue PRO로 업그레이드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je scanlimiet bereikt. Upgrade naar Brickvalue Pro om door te gaan."
          }
        },
        "pt-BR": {
