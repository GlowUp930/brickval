    "Too many requests. Please try again shortly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد عدد كبير جدًا من الطلبات. يرجى المحاولة مرة أخرى قريبًا."
          }
        },
        "de": {
