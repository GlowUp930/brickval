    "Your feedback helps us focus BrickValue on what collectors need most.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعدنا ملاحظاتك في تركيز BrickValue على ما يحتاجه الجامعون أكثر."
          }
        },
        "de": {
          "stringUnit": {
