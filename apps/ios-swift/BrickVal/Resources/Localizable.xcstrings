    "Apple couldn't authorize this purchase on this device or account. Check your App Store or Screen Time purchase settings, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتمكن Apple من تفويض عملية الشراء هذه على هذا الجهاز أو الحساب. تحقق من إعدادات شراء App Store أو Screen Time، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple konnte diesen Kauf auf diesem Gerät oder Konto nicht autorisieren. Überprüfen Sie Ihre App Store- oder Screen Time-Kaufeinstellungen und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't authorize this purchase on this device or account. Check your App Store or Screen Time purchase settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo autorizar esta compra en este dispositivo o cuenta. Comprueba la configuración de compra de App Store o Screen Time y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'a pas pu autoriser cet achat sur cet appareil ou compte. Vérifiez les paramètres d'achat de l'App Store ou du Temps d'écran, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple इस डिवाइस या अकाउंट पर इस खरीदारी को अधिकृत नहीं कर सका। अपना ऐप स्टोर या स्क्रीन टाइम खरीद सेटिंग देखें, फिर दोबारा कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non ha potuto autorizzare questo acquisto su questo dispositivo o account. Controlla le impostazioni di acquisto del tuo App Store o Screen Time, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleはこのデバイスまたはアカウントでこの購入を承認できませんでした。App Storeまたはスクリーンタイムの購入設定を確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 이 기기 또는 계정에서 이 구매를 승인할 수 없습니다. App Store 또는 Screen Time 구매 설정을 확인한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple kon deze aankoop niet autoriseren op dit apparaat of account. Controleer de aankoopinstellingen van de App Store of Schermtijd en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não conseguiu autorizar esta compra neste dispositivo ou conta. Verifique as configurações de compra da App Store ou do Screen Time e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple无法在此设备或帐户上授权此购买。请检查您的App Store或Screen Time购买设置，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple無法在此裝置或帳戶上授權此購買。請檢查App Store或「螢幕使用時間」的購買設定，然後再試一次。"
          }
        }
      }
    },
