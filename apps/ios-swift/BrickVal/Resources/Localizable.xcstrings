            "state": "translated",
            "value": "कोई मिनीफ़िगर मैच नहीं मिला। एक नज़दीकी, चमकीली फ़ोटो आज़माएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna corrispondenza di minifigure trovata. Prova una foto più ravvicinata e luminosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミニフィギュアの一致が見つかりませんでした。もっと近くで明るい写真をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 미니 피규어가 없습니다. 더 가깝고 밝은 사진을 사용해보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen minifiguur gevonden. Probeer een kortere, helderdere foto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma correspondência de minifigura foi encontrada. Experimente uma foto mais próxima e brilhante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到匹配的小人仔。尝试拍摄更近、更亮的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到匹配的小人仔。嘗試拍攝更近、更亮的照片。"
          }
        }
      }
    },
    "No minifigures were found. Try a brighter photo with the figures separated and facing forward.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على أرقام مصغرة. جرب صورة أكثر إشراقًا مع فصل الأشكال وتوجيهها للأمام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine Minifiguren gefunden. Probieren Sie ein helleres Foto aus, bei dem die Figuren getrennt und nach vorne gerichtet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No minifigures were found. Try a brighter photo with the figures separated and facing forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado minifiguras. Prueba con una foto más brillante con las figuras separadas y mirando hacia adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune figurine n'a été trouvée. Essayez une photo plus lumineuse avec les figures séparées et tournées vers l'avant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई छोटी - छोटी तस्वीरें नहीं मिलीं। अलग किए गए और आगे की ओर मुँह किए गए चित्रों के साथ एक उज्ज्वल फ़ोटो आज़माएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono state trovate minifigure. Prova una foto più luminosa con le figure separate e rivolte in avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミニフィギュアは見つかりませんでした。図形を分離して前を向いた明るい写真をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미니 피규어를 찾을 수 없습니다. 피규어를 분리하고 정면을 향하게 하여 더 밝은 사진을 찍어보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen minifiguren gevonden. Probeer een helderdere foto met de figuren gescheiden en naar voren gericht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram encontradas minifiguras. Tente uma foto mais brilhante com as figuras separadas e voltadas para a frente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有发现小人仔。尝试一张更明亮的照片，人物分开并面向前方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有發現小人仔。嘗試一張更明亮的照片，人物分開並面向前方。"
          }
        }
      }
    },
