    "The App Store couldn't complete this purchase. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على App Store إكمال عملية الشراء هذه. يرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte diesen Kauf nicht abschließen. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store couldn't complete this purchase. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store no ha podido completar esta compra. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store n'a pas pu finaliser cet achat. Veuillez réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप स्टोर यह खरीदारी पूरी नहीं कर सका। कृपया फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store non ha potuto completare questo acquisto. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeはこの購入を完了できませんでした。再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 이 구매를 완료할 수 없습니다. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store kon deze aankoop niet voltooien. Probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não conseguiu concluir esta compra. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store无法完成此购买。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 無法完成此購買。請再試一次。"
          }
        }
      }
    },
    "The App Store paywall shows the full renewal price and any trial terms before you confirm.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض جدار الدفع في App Store سعر التجديد الكامل وأي شروط تجريبية قبل التأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Paywall des App Store zeigt den vollständigen Verlängerungspreis und alle Testbedingungen an, bevor du sie bestätigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store paywall shows the full renewal price and any trial terms before you confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El muro de pago de la App Store muestra el precio de renovación completo y las condiciones de prueba antes de confirmarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paywall de l'App Store affiche le prix de renouvellement complet et toutes les conditions d'essai avant que vous ne confirmiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप स्टोर पेवॉल आपके कन्फ़र्म करने से पहले रिन्यूअल का पूरा किराया और ट्रायल की कोई भी शर्त दिखाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il paywall dell'App Store mostra il prezzo di rinnovo completo ed eventuali termini di prova prima che tu confermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認する前に、App Storeのペイウォールに更新料金とトライアル期間が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하기 전에 App Store 페이월에 전체 갱신 가격과 체험 약관이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store-paywall toont de volledige verlengingsprijs en eventuele proefvoorwaarden voordat je bevestigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O paywall da App Store mostra o preço total da renovação e quaisquer termos de avaliação antes de confirmar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您确认之前， App Store付费墙会显示完整的续订价格和任何试用条款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您確認之前，App Store 付費牆會顯示完整的續訂價格和任何試用條款。"
          }
        }
      }
    },
