            "value": "Upgrade-Optionen sind vorübergehend nicht verfügbar. Versuche es in Kürze erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade options are temporarily unavailable. Try again shortly."
          }
        },
