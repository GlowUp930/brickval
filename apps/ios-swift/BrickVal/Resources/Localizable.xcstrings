    "No minifigure match was found. Try a closer, brighter photo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على تطابق في الشكل المصغر. جرب صورة أقرب وأكثر إشراقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde keine Minifigur gefunden. Probieren Sie ein näheres, helleres Foto aus."
          }
