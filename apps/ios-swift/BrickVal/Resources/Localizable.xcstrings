          "stringUnit": {
            "state": "translated",
            "value": "Las opciones de actualización no están disponibles temporalmente. Inténtalo de nuevo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options de mise à niveau sont temporairement indisponibles. Réessayez sous peu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपग्रेड करने के विकल्प कुछ समय के लिए उपलब्ध नहीं हैं। जल्द ही फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
