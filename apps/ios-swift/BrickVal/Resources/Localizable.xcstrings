    "Help us understand what makes BrickValue worth keeping.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعدنا على فهم ما يجعل BrickValue يستحق الاحتفاظ به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helfen Sie uns zu verstehen, was BrickValue wert ist, beibehalten zu werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help us understand what makes BrickValue worth keeping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayúdanos a entender qué hace que BrickValue valga la pena conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez-nous à comprendre ce qui fait que BrickValue vaut la peine d'être conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समझने में हमारी मदद करें कि BrickValue को बनाए रखने के लायक क्या है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiutaci a capire cosa rende BrickValue degno di essere conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValueを維持する価値がある理由を理解するのにご協力ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickValue를 유지할 가치가 있는 이유를 알려주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Help ons te begrijpen wat BrickValue de moeite waard maakt om te houden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude-nos a entender o que faz com que o BrickValue valha a pena manter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助我们了解BrickValue值得保留的原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫助我們瞭解是什麼讓 BrickValue 值得保留。"
          }
        }
      }
    },
