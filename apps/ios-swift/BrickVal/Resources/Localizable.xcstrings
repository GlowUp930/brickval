    "Sign in to get your invite code and keep your bonus scans connected to your account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول للحصول على رمز دعوتك وإبقاء عمليات المسح الضوئي للمكافآت متصلة بحسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich an, um Ihren Einladungscode zu erhalten und Ihre Bonusscans mit Ihrem Konto zu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to get your invite code and keep your bonus scans connected to your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para obtener tu código de invitación y mantener tus escaneos de bonos conectados a tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour obtenir votre code d'invitation et garder vos scans bonus connectés à votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना इनवाइट कोड पाने के लिए साइन इन करें और अपने बोनस स्कैन को अपने अकाउंट से कनेक्ट रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per ottenere il tuo codice di invito e mantenere le tue scansioni bonus collegate al tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインして招待コードを取得し、ボーナス スキャンをアカウントに接続したままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하여 초대 코드를 받고 보너스 스캔을 계정에 계속 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in om je uitnodigingscode te ontvangen en je bonusscans verbonden te houden met je account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão para obter o seu código de convite e manter as suas verificações de bónus ligadas à sua conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录以获取邀请码，并将奖金扫描与您的账号保持关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入以取得邀請代碼，並將額外掃描資料連結至你的帳戶。"
          }
        }
      }
    },
