          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入未完成。請檢查網路連線，然後再試一次。"
          }
        }
      }
    },
    "Sign-in is disabled in preview. Use Skip to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعطيل تسجيل الدخول في المعاينة. استخدم Skip للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist in der Vorschau deaktiviert. Verwenden Sie Überspringen, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in is disabled in preview. Use Skip to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión está desactivado en la vista previa. Utilice Omitir para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion est désactivée dans l'aperçu. Utilisez Ignorer pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीव्यू में साइन - इन बंद है। जारी रखने के लिए 'छोड़ें' का इस्तेमाल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso è disabilitato in anteprima. Usa Salta per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューではサインインが無効になっています。続行するには「スキップ」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에서 로그인이 비활성화되었습니다. 계속하려면 건너뛰기를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanmelden is uitgeschakeld in voorbeeldweergave. Gebruik Overslaan om door te gaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão está desativado na pré-visualização. Use Pular para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览中禁用登录。使用“跳过”继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽中已停用登入。使用「略過」以繼續。"
          }
        }
      }
    },
    "Sign-in is required to create and track invitations.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم تسجيل الدخول لإنشاء الدعوات وتتبعها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Erstellen und Verfolgen von Einladungen ist eine Anmeldung erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in is required to create and track invitations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión es obligatorio para crear y hacer un seguimiento de las invitaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une connexion est nécessaire pour créer et suivre les invitations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनवाइट बनाने और उन्हें ट्रैक करने के लिए साइन - इन करना ज़रूरी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
