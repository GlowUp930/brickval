    "Smart Scan waits for a clear, steady minifigure before taking the photo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسح الضوئي الذكي ينتظر صورة مصغرة واضحة وثابتة قبل التقاط الصورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Scan wartet auf eine klare, stetige Minifigur, bevor das Foto aufgenommen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Scan waits for a clear, steady minifigure before taking the photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Scan espera una minifigura clara y constante antes de tomar la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Scan attend une figurine claire et stable avant de prendre la photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मार्ट स्कैन फ़ोटो लेने से पहले एक स्पष्ट, स्थिर मिनीफ़िगर का इंतज़ार करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Scan attende una minifigure chiara e stabile prima di scattare la foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマート スキャンは、写真を撮る前に、ミニフィギュアが鮮明で安定するのを待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 스캔은 사진을 찍기 전에 선명하고 안정적인 미니피겨를 기다립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Scan wacht op een duidelijke, stabiele minifiguur voordat je de foto maakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Smart Scan aguarda uma minifigura nítida e estável antes de tirar a foto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能扫描会在拍摄照片之前等待清晰、稳定的小人仔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智能掃描會在拍攝照片之前等待清晰、穩定的小人仔。"
          }
        }
      }
    },
