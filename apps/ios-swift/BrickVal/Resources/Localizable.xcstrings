    "Auto-detection watches for one figure and captures when the frame is ready for a faster result.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراقب الكشف التلقائي لشخص واحد ويلتقط عندما يكون الإطار جاهزًا للحصول على نتيجة أسرع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Erkennung überwacht eine Figur und erfasst, wenn der Rahmen für ein schnelleres Ergebnis bereit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-detection watches for one figure and captures when the frame is ready for a faster result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección automática observa una figura y captura cuando el marco está listo para obtener un resultado más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection automatique surveille une figure et capture lorsque le cadre est prêt pour un résultat plus rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटो - डिटेक्शन एक आकृति के लिए देखता है और तेजी से परिणाम के लिए फ्रेम तैयार होने पर कैप्चर करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento automatico osserva una figura e cattura quando la cornice è pronta per un risultato più veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出は1つのフィギュアを監視し、フレームがより速い結果の準備ができたときにキャプチャします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 감지는 하나의 피규어를 감시하고 프레임이 더 빠른 결과를 위해 준비되었을 때 캡처합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autodetectie kijkt naar één figuur en legt vast wanneer het frame klaar is voor een sneller resultaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção automática observa uma figura e captura quando o quadro está pronto para um resultado mais rápido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测监视一个数字，并在帧准备就绪时捕获，以获得更快的结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動偵測會監視一個數字，並在畫面準備就緒時進行捕捉，以獲得更快的結果。"
          }
        }
      }
    },
