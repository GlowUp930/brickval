    "A preview is ready. Your photo stays on this device until you choose to share it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة جاهزة. تظل صورتك على هذا الجهاز حتى تختار مشاركتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vorschau ist fertig. Ihr Foto bleibt auf diesem Gerät, bis Sie es freigeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preview is ready. Your photo stays on this device until you choose to share it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está lista una vista previa. Tu foto permanecerá en este dispositivo hasta que decidas compartirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aperçu est prêt. Votre photo reste sur cet appareil jusqu'à ce que vous choisissiez de la partager."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पूर्वावलोकन तैयार है। जब तक आप इसे शेयर करने का विकल्प नहीं चुनते, तब तक आपकी फ़ोटो इस डिवाइस पर बनी रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'anteprima è pronta. La tua foto rimane su questo dispositivo fino a quando non scegli di condividerla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューの準備ができました。写真は、共有を選択するまでこのデバイスに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기가 준비되었습니다. 사진은 공유하도록 선택할 때까지 이 기기에 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een voorbeeld is klaar. Je foto blijft op dit apparaat staan totdat je ervoor kiest om deze te delen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pré-visualização está pronta. Sua foto permanece neste dispositivo até que você decida compartilhá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览已准备就绪。您的照片会保留在此设备上，直至您选择分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽已準備就緒。您的照片將保留在此設備上，直到您選擇共享為止。"
          }
        }
      }
    },
