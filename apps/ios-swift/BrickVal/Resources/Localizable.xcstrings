    "Pick one. This helps BrickValue guide your first scan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر واحدًا. يساعد هذا BrickValue في توجيه المسح الضوئي الأول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine aus. Dies hilft BrickValue, Ihren ersten Scan zu leiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one. This helps BrickValue guide your first scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige uno. Esto ayuda a BrickValue a guiar tu primer escaneo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en un. Cela aide BrickValue à guider votre premier scan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक चुनें। यह BrickValue को आपके पहले स्कैन का मार्गदर्शन करने में मदद करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline uno. Questo aiuta BrickValue a guidare la tua prima scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つ選んでください。これは、BrickValue が最初のスキャンをガイドするのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나를 선택하세요. 이렇게 하면 BrickValue가 첫 번째 스캔을 안내하는 데 도움이 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies er een. Dit helpt BrickValue je eerste scan te begeleiden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um. Isso ajuda o BrickValue a guiar sua primeira varredura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个。这有助于BrickValue指导您的第一次扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個。這有助於BrickValue引導您的第一次掃描。"
          }
        }
      }
    },
    "Pick the emoji that fits best.": {
