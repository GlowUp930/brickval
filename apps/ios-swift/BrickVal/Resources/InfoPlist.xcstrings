    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue uses your camera to scan LEGO sets, minifigures, and parts for market prices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue usa la cámara para escanear sets, minifiguras y piezas LEGO y consultar sus precios de mercado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue utilise votre appareil photo pour scanner des sets, des minifigurines et des pièces LEGO et consulter leurs prix du marché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue verwendet deine Kamera, um LEGO-Sets, Minifiguren und Teile zu scannen und Marktpreise abzurufen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue usa la fotocamera per scansionare set, minifigure e pezzi LEGO e consultarne i prezzi di mercato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Brickvalue usa sua câmera para escanear conjuntos, minifiguras e peças LEGO e consultar os preços de mercado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue gebruikt je camera om LEGO-sets, minifiguren en onderdelen te scannen en marktprijzen te bekijken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BrickvalueはカメラでLEGOセット、ミニフィギュア、パーツをスキャンし、市場価格を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue는 카메라로 LEGO 세트, 미니피겨, 부품을 스캔해 시장 가격을 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue 使用相机扫描 LEGO 套装、人仔和零件，以查询市场价格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue 使用相機掃描 LEGO 套裝、人偶和零件，以查詢市場價格。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Brickvalue الكاميرا لمسح مجموعات LEGO والشخصيات الصغيرة والقطع لمعرفة أسعار السوق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue आपके कैमरे से LEGO सेट, मिनीफ़िगर और पार्ट्स स्कैन करके बाज़ार कीमतें दिखाता है।"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue lets you choose an existing LEGO photo to scan for market prices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue te permite elegir una foto de LEGO existente para consultar precios de mercado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue vous permet de choisir une photo LEGO existante pour consulter les prix du marché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue lässt dich ein vorhandenes LEGO-Foto auswählen, um Marktpreise abzurufen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue ti permette di scegliere una foto LEGO esistente per consultarne i prezzi di mercato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Brickvalue permite escolher uma foto LEGO existente para consultar os preços de mercado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met Brickvalue kun je een bestaande LEGO-foto kiezen om marktprijzen te bekijken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalueでは既存のLEGO写真を選んで市場価格を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue에서 기존 LEGO 사진을 선택해 시장 가격을 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue 允许你选择现有的 LEGO 照片来查询市场价格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue 允許你選擇現有的 LEGO 照片來查詢市場價格。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك Brickvalue اختيار صورة LEGO موجودة لمعرفة أسعار السوق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickvalue आपको बाज़ार कीमतें देखने के लिए LEGO की मौजूदा फ़ोटो चुनने देता है।"
          }
        }
      }
    }
  },
  "version": "1.0"
}
